out/
release/
captures/
.externalNativeBuild/
.cxx/
output-metadata.json
*.apk
*.aab
*.ap_
*.dex
*.class
*.hprof

# ---------- Gradle / Kotlin 缓存 ----------
.gradle/
android/.gradle/
.kotlin/
android/.kotlin/
gradle-app.setting
.gradletasknamecache

# ---------- 本地环境配置（各机器路径不同）----------
local.properties
android/local.properties

# ---------- 签名密钥：切勿上传，泄露即等于应用被他人冒名发布 ----------
*.jks
*.keystore
*.p12
*.p8
keystore/
signing.properties

# ---------- 日志 ----------
*.log

# ---------- 第三方服务配置（含 API Key，按需放开）----------
google-services.json

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml
.vscode/
.claude/
.settings/
.project
.classpath

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db

